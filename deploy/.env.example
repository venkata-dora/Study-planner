# Copy to deploy/.env. Local Docker only; production must use HTTPS and DEBUG=false.
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-password
DJANGO_SECRET_KEY=replace-with-a-random-secret-at-least-50-characters-long
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
TRUST_PROXY=false
# OpenAI-compatible provider endpoint including /v1. No provider is assumed.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
